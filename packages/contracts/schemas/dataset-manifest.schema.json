{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halo-learning.local/schemas/dataset-manifest.schema.json",
  "title": "DatasetManifest",
  "type": "object",
  "required": [
    "schemaVersion", "datasetId", "name", "locale", "version", "source",
    "license", "hash", "files", "bundled", "redistributionNote"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "locale": { "enum": ["en", "zh-Hant"] },
    "version": { "type": "string", "minLength": 1 },
    "releaseIdentity": { "type": "string", "minLength": 1 },
    "formatVersion": { "type": "string", "minLength": 1 },
    "attributionRequirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redistributionRequirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source": {
      "type": "object",
      "required": ["publisher", "canonicalUrl", "acquiredAt", "retrievalMode"],
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "canonicalUrl": { "type": "string", "minLength": 1 },
        "acquiredAt": { "type": "string", "format": "date-time" },
        "retrievalMode": { "enum": ["user-supplied", "verified-release", "synthetic-fixture"] },
        "transport": {
          "type": "object",
          "required": ["kind", "url", "revision", "note"],
          "properties": {
            "kind": { "enum": ["direct-upstream", "pinned-public-mirror"] },
            "url": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 },
            "note": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "license": { "$ref": "license-record.schema.json" },
    "hash": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "files": { "type": "array", "minItems": 1 },
    "bundled": { "type": "boolean" },
    "redistributionNote": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": { "retrievalMode": { "const": "verified-release" } },
            "required": ["retrievalMode"]
          }
        }
      },
      "then": {
        "required": [
          "releaseIdentity", "formatVersion", "attributionRequirements",
          "redistributionRequirements"
        ],
        "properties": { "source": { "required": ["transport"] } }
      }
    }
  ],
  "additionalProperties": false
}
