{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halo-learning.local/schemas/semantic-annotation.schema.json",
  "title": "SemanticAnnotation/v1",
  "type": "object",
  "required": [
    "schemaVersion", "annotationId", "type", "value", "confidence", "source",
    "provider", "algorithm", "generatedAt", "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "annotationId": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "value": {},
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "type": "string", "minLength": 1 },
    "provider": { "$ref": "#/$defs/identity" },
    "algorithm": { "$ref": "#/$defs/identity" },
    "datasetRef": {
      "type": "object",
      "required": ["datasetId", "datasetVersion"],
      "properties": {
        "datasetId": { "type": "string", "minLength": 1 },
        "datasetVersion": { "type": "string", "minLength": 1 },
        "recordRef": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "provenance": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
