{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halo-learning.local/schemas/lexical-entry.schema.json",
  "title": "LexicalEntry",
  "type": "object",
  "required": ["schemaVersion", "entryId", "locale", "surface", "normalizedSurface", "lemma", "pos", "posConfidence", "glosses", "glossRefs", "aliases", "source", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entryId": { "type": "string", "minLength": 1 },
    "locale": { "enum": ["en", "zh-Hant"] },
    "surface": { "type": "string", "minLength": 1 },
    "normalizedSurface": { "type": "string", "minLength": 1 },
    "lemma": { "type": "string", "minLength": 1 },
    "pos": { "enum": ["n", "v", "adj", "adv", "prep", "conj", "det", "pron", "aux", "modal", "x"] },
    "posConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "glosses": { "type": "array", "minItems": 1 },
    "glossRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object",
      "required": ["datasetId", "version", "recordRef", "lineNumber"],
      "properties": {
        "datasetId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "recordRef": { "type": "string", "minLength": 1 },
        "lineNumber": { "type": "integer", "minimum": 1 },
        "recordData": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
