{
  "name": "halo-learning",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first, provider-agnostic Halo Learning reference implementation",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:baseline": "node --test tests/linguistics.test.js tests/projection.test.js tests/source-contract.test.js",
    "build:data": "node scripts/build-lexical-data.js",
    "build:runtime": "node --max-old-space-size=2048 scripts/build-lexical-runtime.js --write",
    "verify:runtime": "node --max-old-space-size=2048 scripts/build-lexical-runtime.js --verify",
    "quality": "node --max-old-space-size=1024 scripts/run-semantic-quality.js --write",
    "quality:verify": "node --max-old-space-size=1024 scripts/run-semantic-quality.js --verify",
    "benchmark:index": "node --expose-gc scripts/benchmark-lexical-index.js",
    "validate:v0.2": "node scripts/validate-v0.2.0.js",
    "validate": "node scripts/validate-v0.4.0.js --development",
    "validate:standalone": "node scripts/validate-v0.4.0.js --standalone",
    "package:release": "node scripts/package-v0.4.0.js",
    "browser:install": "playwright install chromium",
    "test:browser": "node --test tests/browser/*.e2e.test.js",
    "profile:browser": "node scripts/profile-browser-runtime.js --write"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
